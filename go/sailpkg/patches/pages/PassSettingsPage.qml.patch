+    function _text(value) {
+        if (value === undefined || value === null)
+            return ""
+        return ("" + value).trim()
+    }
+    function _date(value) {
+        var s = _text(value)
+        if (s.length === 0)
+            return ""
+        if (s.indexOf("T") < 0 && s.length >= 10) {
+            var parts = s.substring(0, 10).split("-")
+            if (parts.length === 3) {
+                var day = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10))
+                if (!isNaN(day.getTime()))
+                    return Qt.formatDate(day, Qt.DefaultLocaleShortDate)
+            }
+        }
+        var d = new Date(s)
+        if (isNaN(d.getTime()))
+            return s
+        return Qt.formatDateTime(d, Qt.DefaultLocaleShortDate)
+    }
+    function _yesNo(value) {
+        return value ? qsTr("Yes") : qsTr("No")
+    }
+    function _styleName(style) {
+        return style === "boardingPass" ? qsTr("Boarding pass")
+             : style === "coupon" ? qsTr("Coupon")
+             : style === "eventTicket" ? qsTr("Event ticket")
+             : style === "storeCard" ? qsTr("Store card")
+             : style === "generic" ? qsTr("Generic")
+             : _text(style)
+    }
+    function _transit(kind) {
+        return kind === "PKTransitTypeAir" ? qsTr("Air")
+             : kind === "PKTransitTypeTrain" ? qsTr("Train")
+             : kind === "PKTransitTypeBus" ? qsTr("Bus")
+             : kind === "PKTransitTypeBoat" ? qsTr("Boat")
+             : kind === "PKTransitTypeGeneric" ? qsTr("Generic transit")
+             : _text(kind)
+    }
+    function _join(list) {
+        if (!list || list.length === undefined)
+            return ""
+        var out = []
+        for (var i = 0; i < list.length; ++i) {
+            var s = _text(list[i])
+            if (s.length > 0)
+                out.push(s)
+        }
+        return out.join("\n")
+    }
+    function _add(rows, label, value) {
+        var s = _text(value)
+        if (s.length > 0)
+            rows.push({ "label": label, "value": s })
+    }
+    function _cardFactsOf(p) {
+        var rows = []
+        if (!p)
+            return rows
+        _add(rows, qsTr("Style"), _styleName(p.passStyle))
+        _add(rows, qsTr("Transit"), _transit(p.transitType))
+        _add(rows, qsTr("Organization"), p.organizationName)
+        _add(rows, qsTr("Description"), p.passDescription)
+        _add(rows, qsTr("Serial number"), p.serialNumber)
+        _add(rows, qsTr("Pass type"), p.passTypeIdentifier)
+        _add(rows, qsTr("Team"), p.teamIdentifier)
+        _add(rows, qsTr("Expires"), _date(p.expirationDate))
+        if (p.expired)
+            _add(rows, qsTr("Expired"), qsTr("Yes"))
+        if (p.voided)
+            _add(rows, qsTr("Voided"), qsTr("Yes"))
+        _add(rows, qsTr("Relevant date"), _date(p.relevantDate))
+        _add(rows, qsTr("Update address"), p.webServiceURL)
+        return rows
+    }
+    function _signFactsOf(p) {
+        var rows = []
+        if (!p || p.ownCard)
+            return rows
+        var v = p.verification || {}
+        _add(rows, qsTr("Trusted"), _yesNo(v.trusted))
+        _add(rows, qsTr("Manifest"), _yesNo(v.manifestOK))
+        _add(rows, qsTr("Signature"), _yesNo(v.signatureOK))
+        _add(rows, qsTr("Certificate chain"), _yesNo(v.chainOK))
+        _add(rows, qsTr("Matches certificate"), _yesNo(v.identityOK))
+        _add(rows, qsTr("Subject"), v.subject)
+        _add(rows, qsTr("Issuer"), v.issuer)
+        _add(rows, qsTr("Organization"), v.organization)
+        _add(rows, qsTr("Valid from"), _date(v.notBefore))
+        _add(rows, qsTr("Valid until"), _date(v.notAfter))
+        _add(rows, qsTr("Certificate pass type"), v.passTypeId)
+        _add(rows, qsTr("Certificate team"), v.teamId)
+        _add(rows, qsTr("Root"), v.root)
+        _add(rows, qsTr("Chain"), _join(v.chain))
+        _add(rows, qsTr("Problems"), _join(v.problems))
+        return rows
+    }
